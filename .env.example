# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://toolza.app

# Google AdSense publisher ID (leave empty to hide ad slots in production)
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot IDs
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=

# Optional: translation provider endpoint (POST {text,source,target} -> {translation})
NEXT_PUBLIC_TRANSLATE_ENDPOINT=
